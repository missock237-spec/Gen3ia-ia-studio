rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function validUpload() {
      return request.resource != null
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('(?:image|audio|video|text|application)/.*');
    }

    // User uploads are intentionally scoped to /uploads. The previous broad
    // /users/{uid}/{allPaths=**} rule also matched /artifacts and made a deny
    // rule ineffective because Storage rules are OR-composed.
    match /users/{userId}/uploads/{allPaths=**} {
      allow read: if owner(userId);
      allow create, update: if owner(userId) && validUpload();
      allow delete: if owner(userId);
    }

    // Server-managed artifacts: clients may download their own artifacts,
    // but cannot write/overwrite them directly.
    match /users/{userId}/artifacts/{allPaths=**} {
      allow read: if owner(userId);
      allow write: if false;
    }

    // Project files remain user-scoped and bounded. Membership/authorization
    // is enforced by the server before issuing project upload paths.
    match /projects/{projectId}/users/{userId}/{allPaths=**} {
      allow read: if owner(userId);
      allow create, update: if owner(userId) && validUpload();
      allow delete: if owner(userId);
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
