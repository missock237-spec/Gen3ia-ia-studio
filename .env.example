# =========================================================
# GEN3IA USER WALLET / CHARIOW
# =========================================================
# Wallet ledger currency. Configure the Chariow top-up product in the same currency.
GEN3IA_WALLET_CURRENCY=EUR
# Public Chariow URL of the Gen3ia "Recharge de solde" pay-what-you-want product.
CHARIOW_TOPUP_STORE_URL=
# Optional: product ID/slug of the same Chariow top-up product for webhook filtering.
CHARIOW_TOPUP_PRODUCT_ID=
# Pulse signing secret (whsec_...) from Chariow Automations -> Pulses.
CHARIOW_PULSE_SECRET=
# Chariow server API key for future API operations.
CHARIOW_API_KEY=

# =========================================================
# GEN3IA USAGE PRICING
# =========================================================
# EUR per 1M tokens. Keep these aligned with your current provider/model contracts.
COST_OPENAI_INPUT_EUR_PER_1M=2.5
COST_OPENAI_OUTPUT_EUR_PER_1M=10
COST_ANTHROPIC_INPUT_EUR_PER_1M=3
COST_ANTHROPIC_OUTPUT_EUR_PER_1M=15
