COST_OPENROUTER_OUTPUT_EUR_PER_1M=5
COST_GLM_INPUT_EUR_PER_1M=1
COST_GLM_OUTPUT_EUR_PER_1M=3
COST_HF_INPUT_EUR_PER_1M=0.8
COST_HF_OUTPUT_EUR_PER_1M=3
